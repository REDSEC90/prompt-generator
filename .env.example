# ── Modo de execução da IA ──────────────────────────────────────────────────────
# auto    → tenta local (Ollama) → remote (API) → offline  [padrão]
# local   → força Ollama local (sem internet)
# remote  → força API remota (Anthropic ou OpenAI)
# offline → sem IA; exibe o prompt gerado pelos templates
AI_MODE=auto

# ── Provider de IA ─────────────────────────────────────────────────────────────
# Para AI_MODE=local: ignorado (sempre usa ollama)
# Para AI_MODE=remote ou auto com fallback remoto: anthropic | openai
AI_PROVIDER=anthropic

# ── Chave de autenticação da API (não necessária para ollama) ──────────────────
# Sem esta chave com provider anthropic/openai, o sistema roda em modo offline.
AI_API_KEY=sk-...

# ── Modelo específico do provider ──────────────────────────────────────────────
# Anthropic : claude-sonnet-4-6, claude-opus-4-6
# OpenAI    : gpt-4o, gpt-4-turbo
# Ollama    : llama3.2, mistral, phi3  (ollama pull <modelo>)
AI_MODEL=claude-sonnet-4-6

# ── Limite de tokens na resposta (aplicado ao fluxo Anthropic) ─────────────────
# Padrão: 4000
AI_MAX_TOKENS=4000

# ── Host do Ollama (padrão: http://localhost:11434) ────────────────────────────
# Altere se o Ollama estiver em outro host ou porta.
# OLLAMA_HOST=http://localhost:11434
