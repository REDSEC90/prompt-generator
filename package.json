{
  "name": "prompt-generator",
  "version": "1.0.0",
  "description": "Gerador de prompts inteligentes para humanos e LLMs",
  "main": "dist/index.js",
  "scripts": {
    "start": "ts-node src/index.ts",
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "test": "jest"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^chalk$": "<rootDir>/tests/__mocks__/chalk.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(@inquirer|ora)/)"
    ]
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.2",
    "chalk": "^5.6.2",
    "dotenv": "^16.0.0",
    "ora": "^9.4.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}
