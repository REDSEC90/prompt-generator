{
  "name": "prompt-generator",
  "version": "1.3.0",
  "description": "CLI inteligente para criar, revisar e executar prompts estruturados para LLMs (ChatGPT, Claude, Gemini, Ollama)",
  "main": "dist/index.js",
  "license": "MIT",
  "author": "REDSEC90",
  "repository": {
    "type": "git",
    "url": "https://github.com/REDSEC90/prompt-generator.git"
  },
  "bugs": {
    "url": "https://github.com/REDSEC90/prompt-generator/issues"
  },
  "homepage": "https://github.com/REDSEC90/prompt-generator#readme",
  "keywords": [
    "prompt", "llm", "ai", "cli", "chatgpt", "claude",
    "ollama", "prompt-engineering", "openai", "anthropic"
  ],
  "scripts": {
    "start": "ts-node src/index.ts",
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "export-dataset": "ts-node src/core/dataset.ts",
    "eval": "ts-node src/core/eval.ts",
    "seed-dataset": "python3 training/seed-dataset.py",
    "setup-ollama": "bash training/setup-ollama.sh",
    "finetune": "python3 training/finetune.py"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.ts"],
    "globals": {
      "ts-jest": {
        "tsconfig": "tsconfig.test.json"
      }
    },
    "moduleNameMapper": {
      "^chalk$": "<rootDir>/tests/__mocks__/chalk.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(@inquirer|ora)/)"
    ]
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.2",
    "chalk": "^5.6.2",
    "dotenv": "^16.0.0",
    "ora": "^9.4.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.39",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}
